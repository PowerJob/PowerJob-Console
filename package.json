{
  "name": "powerjob-console",
  "version": "5.1.6-fev3.rc.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests --no-warn-ignored",
