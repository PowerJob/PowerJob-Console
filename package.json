    "check": "npm run lint && npm test && npm run build",
    "package": "npm run build && node script/package-release.mjs"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "json-bigint": "1.0.0",
    "monaco-editor": "0.57.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11",
    "@types/json-bigint": "1.0.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "20.14.5",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "typescript-eslint": "8.57.1"
  },
  "consoleRelease": "5.1.6_fev3-rc.2"
}
