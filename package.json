{
  "name": "powerjob-console",
  "version": "6.0.0-dev.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 24800",
    "serve": "vite --host 127.0.0.1 --port 24800",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build_spring": "tsc --noEmit && vite build --mode spring",
    "preview": "vite preview --host 127.0.0.1 --port 24800",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.10.0",
    "antd": "^6.0.0",
    "dayjs": "^1.11.13",
    "json-bigint": "^1.0.0",
    "lucide-react": "^1.49.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
